<plist version="1.0">
<dict>
    <key>Label</key><string>com.github.goxlr-on-linux.goxlr-utility</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/GoXLR Utility.app/Contents/Helpers/GoXLR Audio Bridge.app/Contents/MacOS/goxlr-daemon</string>
